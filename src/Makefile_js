# ==============================================================================
# Fairy-Stockfish UCI Engine WASM Makefile
# ==============================================================================

EXE = ../tests/js/fairy-stockfish.js

SRCS = main.cpp benchmark.cpp bitbase.cpp bitboard.cpp endgame.cpp evaluate.cpp \
	material.cpp misc.cpp movegen.cpp movepick.cpp pawns.cpp position.cpp psqt.cpp \
	search.cpp thread.cpp timeman.cpp tt.cpp uci.cpp ucioption.cpp tune.cpp syzygy/tbprobe.cpp \
	nnue/evaluate_nnue.cpp nnue/features/half_ka_v2.cpp \
	partner.cpp parser.cpp piece.cpp variant.cpp xboard.cpp \
	nnue/features/half_ka_v2_variants.cpp

ifeq ($(OS),Windows_NT)
    CXX = emcc.bat
else
    CXX = emcc
endif

CXXFLAGS += -DNNUE_EMBEDDING_OFF -pthread -std=c++17 -Wall
CXXFLAGS += -s ASYNCIFY=1 -s ASYNCIFY_STACK_SIZE=65536
CXXFLAGS += --embed-file variants.ini@/variants.ini

# CÁC CỜ CHO UCI ENGINE
LDFLAGS += -pthread -s PTHREAD_POOL_SIZE=4
LDFLAGS += -s WASM=1 \
           -s ALLOW_MEMORY_GROWTH=1 \
           -s MODULARIZE=1 \
           -s EXPORT_NAME="Stockfish" \
           -s EXPORTED_FUNCTIONS="['_main']" \
           -s EXPORTED_RUNTIME_METHODS="['FS','print','printErr','ccall','cwrap','stringToNewUTF8','lengthBytesUTF8']" \
           -s ENVIRONMENT="web,worker"

largeboards = yes
all = yes
optimize = yes
debug = no

ifeq ($(debug),no)
	CXXFLAGS += -DNDEBUG -s ASSERTIONS=0 -s SAFE_HEAP=0
else
	CXXFLAGS += -g -s ASSERTIONS=1 -s SAFE_HEAP=1
endif

ifeq ($(optimize),yes)
	CXXFLAGS += -O3
endif

ifneq ($(largeboards),no)
	CXXFLAGS += -DLARGEBOARDS -DPRECOMPUTED_MAGICS -s TOTAL_MEMORY=64MB -s WASM_MEM_MAX=1GB
endif

ifneq ($(all),no)
	CXXFLAGS += -DALLVARS
endif

.PHONY: clean build

clean:
	@rm -f $(EXE) $(EXE:.js=.wasm) 2>nul || exit 0

build:
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(SRCS) -o $(EXE)